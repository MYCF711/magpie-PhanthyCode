{
  "name": "magpie-phanthycode",
  "version": "0.2.0",
  "description": "magpie 插件：用 PhanthyCode 账号直连 code.phanthy.com 的模型目录、积分额度与设备密钥签名（不需要桌面端）",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md",
    "ERROR-CODES.md",
    "HOOKS.md",
    "PROTOCOL-INFERENCE.md",
    "registry-entry.json"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "checkin",
    "phanthycode"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/png;base64,",
    "maxConcurrency": 4,
    "name": "PhanthyCode 云端"
  },
  "scripts": {
    "test": "node --test --import ./tests/helpers/network-guard.mjs",
    "check": "node scripts/check.mjs",
    "check:errors": "node scripts/check-error-codes.mjs .",
    "check:ua": "node scripts/check-ua.mjs .",
    "check:docs": "node scripts/check-docs.mjs",
    "score": "node scripts/score.mjs",
    "release": "node scripts/release.mjs",
    "maintenance": "node scripts/check-maintenance.mjs",
    "check:actions": "node scripts/check-actions.mjs",
    "publish:npm": "node scripts/publish-npm.mjs"
  }
}
